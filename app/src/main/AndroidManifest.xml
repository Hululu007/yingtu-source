<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- MPV(libmpv) 的 AAR 声明 minSdk 26；本 App minSdk 24。
         用 overrideLibrary 允许合并，MPV 内核在 <26 设备上不选用即可（默认 Exo）。 -->
    <uses-sdk tools:overrideLibrary="dev.jdtech.mpv" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <!-- 应用页（AppsActivity）列出已装可启动应用：Android 11+ 没有这段声明，
         queryIntentActivities 只能看到少量应用；只声明启动器 intent，不申请 QUERY_ALL_PACKAGES。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:banner="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.activity.FirstActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true"
            android:screenOrientation="sensorPortrait"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.activity.HomeActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ui.activity.SearchActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ui.activity.DetailActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ui.activity.FolderActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ui.activity.VideoActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="portrait"
            android:supportsPictureInPicture="true"
            android:theme="@style/AppTheme.Fullscreen" />

        <activity
            android:name=".ui.activity.WebHomeActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout"
            android:hardwareAccelerated="true"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ui.activity.WebHomeListActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ui.activity.OnlineSiteListActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ui.activity.OnlineSiteBrowserActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout"
            android:hardwareAccelerated="true"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ui.activity.SettingActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ui.activity.MoreSettingsActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ui.activity.AdvancedConfigActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ui.activity.SourceActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ui.activity.BuiltinZoneActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ui.activity.OneKeyPyActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ui.activity.HistoryActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ui.activity.FastSearchActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ui.activity.CollectActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ui.activity.AppsActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ui.activity.LiveActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ui.activity.DriveActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ui.activity.PushActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ui.activity.EpgActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ui.activity.DramaPlayerActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="unspecified"
            android:theme="@style/AppTheme.Fullscreen" />

        <activity
            android:name=".ui.activity.WallpaperActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="unspecified" />

        <activity
            android:name=".ui.activity.FileActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true"
            android:screenOrientation="unspecified">
            <!-- 外部导入 py：别的 App 以 ACTION_VIEW / ACTION_SEND 分享 .py 文件过来，
                 直接打开本 App 的 py 导入模式，走与文件 tab 同一条导入注册链路。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/x-python" />
                <data android:mimeType="application/x-python" />
                <data android:mimeType="text/plain" />
                <data android:pathPattern=".*\\.py" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/x-python" />
                <data android:mimeType="application/x-python" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.activity.PlaybackRecoveryActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:process=":playback_recovery"
            android:screenOrientation="unspecified" />

        <service
            android:name=".service.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- DLNA 发现：jupnp 的 AndroidUpnpServiceImpl（须声明，否则绑定失败）。 -->
        <service
            android:name="org.jupnp.android.AndroidUpnpServiceImpl"
            android:exported="false" />

        <!-- 开机 / 更新后恢复：后台播放中重启过，发一条续播通知（不自动重播）。 -->
        <receiver
            android:name=".service.PlaybackBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 开机自动启动（设置 → 更多设置）：开关开时开机拉起首页；Android 10+ 可能被系统拦截。 -->
        <receiver
            android:name=".service.BootStartReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
