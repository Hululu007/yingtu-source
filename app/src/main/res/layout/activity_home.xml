<?xml version="1.0" encoding="utf-8"?>
<!-- 首页外壳（第八版）：顶栏 + 内容区全屏；底部导航已删，五个去向收进右侧边栏——
     平时右边缘只留一条细把手，从边缘向左划或点把手滑出面板，点选或 5 秒不动自动收回。
     边缘划入只认最右 16dp 那一小段（顶栏 56dp 高度内不占，设置齿轮的点按不受影响，
     也不抢内容区分类 chips 的横滑）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- 内容区：顶栏 + 影视/短剧/午夜/收藏页（底部导航腾出的位置归内容，全屏显示） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶栏：Logo（缩小）+ 站点名 + 居中搜索框 + 右上角五个图标入口 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="站源"
                android:src="@drawable/logo" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="110dp"
                android:text="@string/source_default"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 居中搜索框：点进搜索页（渔老 webhtv 做法：顶栏无边框输入框样式） -->
            <TextView
                android:id="@+id/tvSearchBox"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:clickable="true"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="6dp"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/hint_search"
                android:textColor="@color/text_hint"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/ivHistory"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="历史"
                android:padding="5dp"
                android:src="@drawable/ic_history"
                app:tint="@color/text_primary" />

            <ImageView
                android:id="@+id/ivFav"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="收藏"
                android:padding="5dp"
                android:src="@drawable/ic_fav_on"
                app:tint="@color/text_primary" />

            <ImageView
                android:id="@+id/ivCast"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="放映"
                android:padding="5dp"
                android:src="@drawable/ic_cast"
                app:tint="@color/text_primary" />

            <ImageView
                android:id="@+id/ivWeb"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="网页"
                android:padding="5dp"
                android:src="@drawable/ic_web"
                app:tint="@color/text_primary" />

            <ImageView
                android:id="@+id/ivSetting"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="设置"
                android:padding="5dp"
                android:src="@drawable/ic_setting"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <!-- 内容区：影视主页 / 短剧占位 / 午夜占位 / 收藏页 -->
        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- 边缘划入区：最右 16dp、顶栏以下；左划 40dp 以上打开侧边栏。
         只认这一小段，不抢内容区分类 chips 的横滑；顶栏那 56dp 不占，
         右上角五个图标的点按不受影响。 -->
    <View
        android:id="@+id/edgeSwipeZone"
        android:layout_width="16dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginTop="56dp"
        android:background="@android:color/transparent" />

    <!-- 小把手：右边缘细条（半透明），点一下滑出面板；收回后一直留着，能再划出来 -->
    <FrameLayout
        android:id="@+id/sidebarHandle"
        android:layout_width="16dp"
        android:layout_height="120dp"
        android:layout_gravity="end|center_vertical"
        android:background="@drawable/bg_sidebar_handle">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:contentDescription="打开导航"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />
    </FrameLayout>

    <!-- 遮罩：面板打开时盖住内容，点一下收回 -->
    <View
        android:id="@+id/sidebarScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone" />

    <!-- 侧边栏面板：八个去向带图标带字排一列，当前区高亮；默认藏在屏幕外 -->
    <LinearLayout
        android:id="@+id/sidebarPanel"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/gradient_bottom"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/sbMovie"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_play_circle"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvSbMovie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="影视"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sbDrama"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_play"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvSbDrama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="短剧"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sbLive"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_live"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvSbLive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="直播"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sbMidnight"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_fav_on"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvSbMidnight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="午夜"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sbFile"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_file"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvSbFile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="文件"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 第九批第二路：快搜 / 收藏 / 应用，三个独立页的直达行，接法与直播/文件同一路 -->
        <LinearLayout
            android:id="@+id/sbFastSearch"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_search"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvSbFastSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="快搜"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sbCollect"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_fav_on"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvSbCollect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="收藏"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sbApps"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_apps"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvSbApps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="应用"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 第九批第三路：网盘 / 推送 / 节目单，三个独立页的直达行，接法与直播/文件同一路 -->
        <LinearLayout
            android:id="@+id/sbDrive"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_folder"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvSbDrive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="网盘"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sbPush"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chat"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvSbPush"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="推送"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sbEpg"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_episode"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvSbEpg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="节目单"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
