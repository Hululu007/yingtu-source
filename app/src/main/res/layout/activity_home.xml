<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 顶栏：Logo（缩小）+ 站点名 + 居中搜索框 + 右上角五个图标入口 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="站源"
            android:src="@drawable/logo" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="110dp"
            android:text="@string/source_default"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 居中搜索框：点进搜索页（渔老 webhtv 做法：顶栏无边框输入框样式） -->
        <TextView
            android:id="@+id/tvSearchBox"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:clickable="true"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="6dp"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/hint_search"
            android:textColor="@color/text_hint"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/ivHistory"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="历史"
            android:padding="5dp"
            android:src="@drawable/ic_history"
            app:tint="@color/text_primary" />

        <ImageView
            android:id="@+id/ivFav"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="收藏"
            android:padding="5dp"
            android:src="@drawable/ic_fav_on"
            app:tint="@color/text_primary" />

        <ImageView
            android:id="@+id/ivCast"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="放映"
            android:padding="5dp"
            android:src="@drawable/ic_cast"
            app:tint="@color/text_primary" />

        <ImageView
            android:id="@+id/ivWeb"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="网页"
            android:padding="5dp"
            android:src="@drawable/ic_web"
            app:tint="@color/text_primary" />

        <ImageView
            android:id="@+id/ivSetting"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="设置"
            android:padding="5dp"
            android:src="@drawable/ic_setting"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <!-- 内容区：影视主页 / 短剧占位 / 午夜占位 / 收藏页 -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 底部导航：影视 / 短剧 / 直播 / 午夜 / 文件 / 设置（菜单在代码里建） -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:labelVisibilityMode="labeled" />

</LinearLayout>
