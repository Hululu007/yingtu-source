<?xml version="1.0" encoding="utf-8"?>
<!-- 频道页：标题 + 当前站 + 筛选行 + 左侧分类栏 + 右侧 chips/网格/短剧分组 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <TextView
        android:id="@+id/channelTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="频道分类"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvChannelSite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:clickable="true"
        android:focusable="true"
        android:textColor="@color/neon_cyan"
        android:textSize="14sp" />

    <!-- 筛选行 -->
    <LinearLayout
        android:id="@+id/filterRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipFilterAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip_neon"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="▾ 全部类型"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/chipFilterTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip_neon"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="热门"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/chipFilterLatest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip_neon"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="最新"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/chipFilterFree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_neon"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="完结"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 下方：左侧分类栏 + 右侧内容 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 左侧分类栏（纵向，LayoutManager 由 Java 设；源码 rail 宽 82dp） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChannelCategory"
            android:layout_width="82dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_channel_sidebar"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <!-- 右侧 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 二级 chips（横向，LayoutManager 由 Java 设） -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChannelChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:clipToPadding="false"
                android:scrollbars="none" />

            <!-- 海报网格（LayoutManager 由 Java 设） -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChannelGrid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:scrollbars="none" />

            <!-- 短剧分组（纵向，LayoutManager 由 Java 设） -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChannelFeed"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/channelProgress"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/colorPrimary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/channelEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
