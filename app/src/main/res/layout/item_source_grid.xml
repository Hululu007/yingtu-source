<?xml version="1.0" encoding="utf-8"?>
<!-- 站源三列网格格子：站名居中、最多两行（长站名不断尾太狠），选中态走背景/文字颜色选择器。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:layout_margin="5dp"
    android:background="@drawable/bg_source_grid_item"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:foreground="?attr/selectableItemBackground">

    <!-- 站源 LOGO 视图（设置 → 更多设置 → 站源选择使用LOGO视图）：开时格子上方显示站源 LOGO（api 域名 favicon，取不到显示首字母）。 -->
    <FrameLayout
        android:id="@+id/logoFrame"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvLogoLetter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/colorPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/source_grid_text_selector"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- 站源管理页检测结果（有结果才显示）：弹窗里不用，保持 gone。 -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textSize="11sp"
        android:visibility="gone" />

</LinearLayout>
