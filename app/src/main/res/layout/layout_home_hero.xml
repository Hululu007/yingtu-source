<?xml version="1.0" encoding="utf-8"?>
<!-- hero 轮播单页卡：三张海报叠放 + 底部标题/标签/马上看 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="300dp"
    android:background="@drawable/bg_hero_card">

    <ImageView
        android:id="@+id/heroPosterLeft"
        android:layout_width="130dp"
        android:layout_height="190dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="28dp"
        android:rotation="-8"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_poster_placeholder" />

    <ImageView
        android:id="@+id/heroPosterRight"
        android:layout_width="130dp"
        android:layout_height="190dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="28dp"
        android:rotation="8"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_poster_placeholder" />

    <ImageView
        android:id="@+id/heroPosterCenter"
        android:layout_width="170dp"
        android:layout_height="240dp"
        android:layout_gravity="center"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_poster_placeholder" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/heroTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/heroTags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnHeroPlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_neon_button"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="马上看"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
