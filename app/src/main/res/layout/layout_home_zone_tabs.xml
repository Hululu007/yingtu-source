<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:id="@+id/tabMovie"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:background="@drawable/bg_tab_pill"
        android:clickable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivTabMovie"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_play_circle"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvTabMovie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="影视"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabDrama"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:background="@drawable/bg_tab_pill"
        android:clickable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivTabDrama"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_play"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvTabDrama"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="短剧"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabLive"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:background="@drawable/bg_tab_pill"
        android:clickable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivTabLive"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_live"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvTabLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="直播"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabMidnight"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:background="@drawable/bg_tab_pill"
        android:clickable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivTabMidnight"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_fav_on"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvTabMidnight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="午夜"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabFile"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:background="@drawable/bg_tab_pill"
        android:clickable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivTabFile"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_file"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvTabFile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="文件"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
