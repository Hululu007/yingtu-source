<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 自定义属性 -->
    <declare-styleable name="CustomAttrs">
        <attr name="exampleString" format="string" />
        <attr name="exampleDimension" format="dimension" />
        <attr name="exampleColor" format="color" />
        <attr name="exampleDrawable" format="reference|color" />
        <attr name="exampleBoolean" format="boolean" />
        <attr name="exampleInt" format="integer" />
        <attr name="exampleFloat" format="float" />
        <attr name="exampleFraction" format="fraction" />
    </declare-styleable>

    <!-- PlayerView 自定义属性 -->
    <declare-styleable name="PlayerView">
        <attr name="use_controller" format="boolean" />
        <attr name="surface_type" format="enum">
            <enum name="surface_view" value="0" />
            <enum name="texture_view" value="1" />
        </attr>
        <attr name="shutter_background_color" format="color" />
        <attr name="resize_mode" format="enum">
            <enum name="fit" value="0" />
            <enum name="fill" value="1" />
            <enum name="zoom" value="2" />
        </attr>
        <attr name="keep_content_on_player_reset" format="boolean" />
    </declare-styleable>

    <!-- 2026-11-08 云构建第二轮失败修法：14 个对话框布局在用 FongMi 的自定义 View
         （CustomNestedScrollView / CustomRecyclerView），布局里写了 app:maxHeight 等属性，
         但树里没有这两个 styleable，aapt 链接不过；声明与 webhtv 的 attrs.xml 相同。 -->
    <declare-styleable name="CustomRecyclerView">
        <attr name="android:minWidth" />
        <attr name="android:minHeight" />
        <attr name="maxWidth" format="dimension" />
        <attr name="maxHeight" format="dimension" />
    </declare-styleable>

    <declare-styleable name="CustomNestedScrollView">
        <attr name="android:minHeight" />
        <!-- maxHeight 的 format 只在上面的 CustomRecyclerView 里定义一次，这里只引用，
             不然 aapt 报 Found item Attr/maxHeight more than one time（第三轮就是这么挂的） -->
        <attr name="maxHeight" />
    </declare-styleable>
</resources>
