<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 基础样式 -->

    <!-- DiscMenu 按钮样式 -->
    <style name="DiscMenuButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@drawable/bg_frost_button</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <!-- WebHTV 浅色弹窗遮罩：MaterialAlertDialogBuilder 的 overlay 参数用 -->
    <style name="ThemeOverlay.WebHTV.LightDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:colorBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">#202124</item>
        <item name="colorOnSurfaceVariant">#5F6368</item>
        <item name="colorPrimary">#1A73E8</item>
        <item name="isLightTheme">true</item>
    </style>

    <!-- Vod Grid Large 样式 -->
    <style name="Vod.Grid.Large" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="AppTheme.Launcher" parent="AppTheme">
        <item name="android:windowBackground">@drawable/startup_window_background</item>
    </style>
</resources>
